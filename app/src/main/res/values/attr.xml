<?xml version="1.0" encoding="utf-8"?>
<resources>
    <declare-styleable name="PuzzleView">
        <attr format="integer" name="line_size"/>
        <attr format="color" name="line_color"/>
        <attr format="color" name="selected_line_color"/>
        <attr format="color" name="handle_bar_color"/>
        <attr format="boolean" name="need_draw_line"/>
        <attr format="boolean" name="need_draw_outer_line"/>
        <attr format="dimension" name="piece_padding"/>
        <attr format="integer" name="animation_duration"/>
        <attr format="float" name="radian"/>
    </declare-styleable>

    <attr name="arcMode">
        <enum name="flip" value="2" />
        <enum name="startHorizontal" value="1" />
        <enum name="startVertical" value="0" />
    </attr>
    <attr name="arc_color" format="color"></attr>
    <attr name="arc_cropCurve">
        <enum name="cropConcave" value="2" />
        <enum name="cropConvex" value="1" />
    </attr>
    <attr name="arc_height" format="dimension"></attr>
    <attr name="arc_position">
        <enum name="bottom" value="1" />
        <enum name="top" value="2" />
    </attr>
</resources>