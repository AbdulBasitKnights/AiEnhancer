<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_look_features"
    app:startDestination="@id/instructionFragment">

    <fragment
        android:id="@+id/instructionFragment"
        android:name="com.aiface.aging.features.look.instruction.InstructionFragment"
        android:label="instructionFragment"
        tools:layout="@layout/fragment_instruction">
        <argument
            android:name="type"
            android:defaultValue="screen_makeup"
            app:argType="string" />
        <action
            android:id="@+id/action_instructionFragment_to_lookImagePicker"
            app:destination="@id/lookImagePicker"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_right" />
    </fragment>

    <fragment
        android:id="@+id/lookImagePicker"
        android:name="com.aiface.aging.features.imgpicker.ui.FragmentImagePicker"
        tools:layout="@layout/fragment_image_picker_bgremover">
        <argument
            android:name="selectedPosition"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="showToolbar"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="albumName"
            android:defaultValue=""
            app:argType="string" />
        <action
            android:id="@+id/action_lookImagePicker_to_cropFragment"
            app:destination="@id/cropFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/lookImagePicker"
            app:popUpToInclusive="true" />
    </fragment>

    <action
        android:id="@+id/action_global_lookImagePicker"
        app:destination="@id/lookImagePicker"
        app:enterAnim="@anim/slide_in_right"
        app:exitAnim="@anim/slide_out_right"
        app:popEnterAnim="@anim/slide_in_right"
        app:popExitAnim="@anim/slide_out_right" />

    <fragment
        android:id="@+id/cropFragment"
        android:name="com.aiface.aging.features.look.crop.CropFragment"
        android:label="fragment_crop"
        tools:layout="@layout/fragment_crop">
        <argument
            android:name="imagePath"
            android:defaultValue=""
            app:argType="string" />
        <argument
            android:name="isHair"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="isFace"
            android:defaultValue="false"
            app:argType="boolean" />
        <action
            android:id="@+id/action_cropFragment_to_hairColorEditorFragment"
            app:destination="@id/hairColorEditorFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/cropFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_cropFragment_to_faceMakeUpFragment"
            app:destination="@id/faceMakeUpFragment"
            app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_right"
            app:popEnterAnim="@anim/slide_in_right"
            app:popExitAnim="@anim/slide_out_right"
            app:popUpTo="@id/cropFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/hairColorEditorFragment"
        android:name="com.aiface.aging.features.look.haircolor.HairColorEditorFragment"
        android:label="fragment_hair_color_editor"
        tools:layout="@layout/fragment_hair_color_editor">
        <action
            android:id="@+id/action_hairColorEditorFragment_to_resultFragment"
            app:destination="@id/resultPreviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/faceMakeUpFragment"
        android:name="com.aiface.aging.features.look.facemakeup.FaceMakeUpFragment"
        android:label="fragment_face_make_up"
        tools:layout="@layout/fragment_face_make_up">
        <action
            android:id="@+id/action_faceMakeUpFragment_to_resultFragment"
            app:destination="@id/resultPreviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultPreviewFragment"
        android:name="com.aiface.aging.features.result.ResultPreviewFragment"
        android:label="fragment_result_preview"
        tools:layout="@layout/fragment_result_preview">
        <argument
            android:name="sourceFeature"
            android:defaultValue="hair_color"
            app:argType="string" />
        <action
            android:id="@+id/action_resultPreviewFragment_to_resultFragment"
            app:destination="@id/resultFragment"
            app:popUpTo="@id/resultPreviewFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.aiface.aging.features.result.ResultFragment"
        android:label="fragment_result"
        tools:layout="@layout/fragment_result">
        <argument
            android:name="sourceFeature"
            android:defaultValue="hair_color"
            app:argType="string" />
    </fragment>

</navigation>
