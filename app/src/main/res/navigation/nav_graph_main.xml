<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_main"
    app:startDestination="@id/mainFragment">

    <fragment
        android:id="@+id/mainFragment"
        android:name="com.aiface.aging.features.main.MainFragment"
        android:label="fragment_main"
        tools:layout="@layout/fragment_main">

        <!-- app:enterAnim="@anim/slide_in_right"
            app:exitAnim="@anim/slide_out_left"
            app:popEnterAnim="@anim/slide_in_left"
            app:popExitAnim="@anim/slide_out_right"-->

        <action
            android:id="@+id/actionHomeToImagPicker"
            app:destination="@id/imagePicker"/>

        <action
            android:id="@+id/actionHomeToMyWork"
            app:destination="@id/myWorkFragment"/>

        <action
            android:id="@+id/actionHomeToSettings"
            app:destination="@id/settingsFragment"/>

        <action
            android:id="@+id/action_homeFragment_to_seeAllFragment"
            app:destination="@id/seeAllFragment" />
        <action
            android:id="@+id/action_homeFragment_to_previewFragment"
            app:destination="@id/previewFragment" />
    </fragment>


    <fragment
        android:id="@+id/imagePicker"
        android:name="com.aiface.aging.features.imgpicker.ui.FragmentImagePicker"
        tools:layout="@layout/fragment_image_picker_bgremover">

        <argument
            android:name="selectedPosition"
            android:defaultValue="0"
            app:argType="integer" />

        <argument
            android:name="showToolbar"
            android:defaultValue="false"
            app:argType="boolean" />

        <argument
            android:name="albumName"
            android:defaultValue=""
            app:argType="string" />


    </fragment>


    <fragment
        android:id="@+id/fragmentCollageHome"
        android:name="com.aiface.aging.features.collage.FragmentCollageTemplates"
        android:label="Collages"
        tools:layout="@layout/fragment_collage_home">
        <argument
            android:name="EXTRA_IS_FRAME_IMAGE"
            android:defaultValue="true"
            app:argType="boolean" />
<!--        <action-->
<!--            android:id="@+id/action_fragmentCollageHome_to_fragmentImagePickerCollage"-->
<!--            app:destination="@id/fragmentImagePickerCollage" />-->

        <action
            android:id="@+id/actionCollageToImagPicker"
            app:destination="@id/imagePicker"/>
    </fragment>


    <fragment
        android:id="@+id/myWorkFragment"
        android:name="com.aiface.aging.features.mywork.FragmentMyWork"
        tools:layout="@layout/fragment_mywork_layout"/>


    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.aiface.aging.features.settings.SettingsFragment"/>

    <action
        android:id="@+id/action_to_nav_collage"
        app:destination="@id/fragmentCollageHome" />

    <fragment
        android:id="@+id/seeAllFragment"
        android:name="com.aiface.aging.features.see_all.SeeAllFragment"
        android:label="See All"
        tools:layout="@layout/fragment_see_all">
        <argument
            android:name="category_id"
            app:argType="string"
            android:defaultValue="" />
        <argument
            android:name="category_name"
            app:argType="string" />
        <action
            android:id="@+id/action_seeAllFragment_to_previewFragment"
            app:destination="@id/previewFragment" />
    </fragment>

    <fragment
        android:id="@+id/previewFragment"
        android:name="com.aiface.aging.features.home.preview.PreviewFragment"
        android:label="Preview"
        tools:layout="@layout/fragment_preview">
        <argument
            android:name="previewImageUrl"
            app:argType="string"
            android:defaultValue="https://picsum.photos/600/900" />

        <action
            android:id="@+id/actionAiPreviewToImagPicker"
            app:destination="@id/imagePicker"/>

<!--        <action-->
<!--            android:id="@+id/action_previewFragment_to_editFragment"-->
<!--            app:destination="@id/editFragment" />-->
    </fragment>

    <fragment
        android:id="@+id/editFragment"
        android:name="com.aiface.aging.features.edit.EditFragment"
        android:label="Edit"
        tools:layout="@layout/fragment_edit">
        <argument
            android:name="imageUri"
            app:argType="string" />
        <action
            android:id="@+id/action_editFragment_to_resultFragment"
            app:destination="@id/resultPreviewFragment" />
    </fragment>

    <fragment
        android:id="@+id/resultPreviewFragment"
        android:name="com.aiface.aging.features.result.ResultPreviewFragment"
        android:label="Result Preview"
        tools:layout="@layout/fragment_result_preview">
        <action
            android:id="@+id/action_resultPreviewFragment_to_resultFragment"
            app:destination="@id/resultFragment"
            app:popUpTo="@id/resultPreviewFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.aiface.aging.features.result.ResultFragment"
        android:label="Result"
        tools:layout="@layout/fragment_result">
        <action
            android:id="@+id/action_resultFragment_to_previewFragment"
            app:destination="@id/previewFragment"
            app:popUpTo="@id/resultFragment"
            app:popUpToInclusive="false" />
<!--        <action-->
<!--            android:id="@+id/action_resultFragment_to_reportFragment"-->
<!--            app:destination="@id/reportFragment" />-->
    </fragment>

    <fragment
        android:id="@+id/bgRemoverFragment"
        android:name="com.aiface.aging.features.bgremover.FragmentAIBGRemover"
        tools:layout="@layout/fragment_ai_bg_remover"/>

    <action
        android:id="@+id/action_to_editFragment"
        app:destination="@id/editFragment" />
    <action
        android:id="@+id/action_to_bgRemover"
        app:destination="@id/bgRemoverFragment" />

    <fragment
        android:id="@+id/blenderFragment"
        android:name="com.aiface.aging.features.blender.BlenderFragment"
        tools:layout="@layout/fragment_blender">
        <action
            android:id="@+id/actionBlenderToImagPicker"
            app:destination="@id/imagePicker" />
    </fragment>

    <fragment
        android:id="@+id/framesFragment"
        android:name="com.aiface.aging.features.frames.FragmentFrames"
        tools:layout="@layout/fragment_frames">
        <action
            android:id="@+id/actionFramesToImagPicker"
            app:destination="@id/imagePicker" />
    </fragment>

    <fragment
        android:id="@+id/faceswapFragment"
        android:name="com.aiface.aging.features.faceswap.FaceSwapFragment"
        tools:layout="@layout/fragment_face_swap">
        <action
            android:id="@+id/actionFaceSwapToImagPicker"
            app:destination="@id/imagePicker" />
    </fragment>

    <fragment
        android:id="@+id/faceSwapGenerateFragment"
        android:name="com.aiface.aging.features.faceswap.FaceSwapGenerateFragment"
        tools:layout="@layout/fragment_faceswap_generate">
        <action
            android:id="@+id/action_faceSwapGenerate_to_result"
            app:destination="@id/faceSwapResultFragment" />
    </fragment>

    <fragment
        android:id="@+id/faceSwapResultFragment"
        android:name="com.aiface.aging.features.faceswap.FaceSwapResultFragment"
        tools:layout="@layout/fragment_result_faceswap" />

    <fragment
        android:id="@+id/myCropFragment"
        android:name="com.aiface.aging.features.blender.crop.MyCropeFragment"
        tools:layout="@layout/fragment_my_crope" />

    <action
        android:id="@+id/action_to_blender"
        app:destination="@id/blenderFragment" />

    <action
        android:id="@+id/action_to_frames"
        app:destination="@id/framesFragment" />

    <action
        android:id="@+id/action_toFaceSwap"
        app:destination="@id/faceswapFragment" />

    <action
        android:id="@+id/action_to_faceSwapGenerate"
        app:destination="@id/faceSwapGenerateFragment" />

    <action
        android:id="@+id/action_global_myCropFragment"
        app:destination="@id/myCropFragment" />

    <action
        android:id="@+id/action_global_settingsFragment"
        app:destination="@id/settingsFragment" />
</navigation>