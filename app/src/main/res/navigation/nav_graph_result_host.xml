<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph_result_host"
    app:startDestination="@id/resultPreviewFragment">

    <fragment
        android:id="@+id/resultPreviewFragment"
        android:name="com.aiface.aging.features.result.ResultPreviewFragment"
        android:label="Result Preview"
        tools:layout="@layout/fragment_result_preview">
        <argument
            android:name="result_source"
            app:argType="string"
            android:defaultValue="AI" />
        <argument
            android:name="local_image_path"
            app:argType="string"
            android:defaultValue=""
            app:nullable="true" />
        <argument
            android:name="local_image_uri"
            app:argType="string"
            android:defaultValue=""
            app:nullable="true" />
        <argument
            android:name="already_saved"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="from_my_work"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="output_image_url"
            app:argType="string"
            android:defaultValue=""
            app:nullable="true" />
        <argument
            android:name="source_feature"
            app:argType="string"
            android:defaultValue=""
            app:nullable="true" />
        <argument
            android:name="media_id"
            app:argType="long"
            android:defaultValue="0L" />
        <argument
            android:name="display_name"
            app:argType="string"
            android:defaultValue=""
            app:nullable="true" />
        <action
            android:id="@+id/action_resultPreviewFragment_to_resultFragment"
            app:destination="@id/resultFragment"
            app:popUpTo="@id/resultPreviewFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/resultFragment"
        android:name="com.aiface.aging.features.result.ResultFragment"
        android:label="Result"
        tools:layout="@layout/fragment_result">
        <argument
            android:name="result_source"
            app:argType="string"
            android:defaultValue="AI" />
        <argument
            android:name="local_image_path"
            app:argType="string"
            android:defaultValue=""
            app:nullable="true" />
        <argument
            android:name="local_image_uri"
            app:argType="string"
            android:defaultValue=""
            app:nullable="true" />
        <argument
            android:name="already_saved"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="from_my_work"
            app:argType="boolean"
            android:defaultValue="false" />
        <argument
            android:name="output_image_url"
            app:argType="string"
            android:defaultValue=""
            app:nullable="true" />
        <argument
            android:name="source_feature"
            app:argType="string"
            android:defaultValue=""
            app:nullable="true" />
        <argument
            android:name="media_id"
            app:argType="long"
            android:defaultValue="0L" />
        <argument
            android:name="display_name"
            app:argType="string"
            android:defaultValue=""
            app:nullable="true" />
        <action
            android:id="@+id/action_resultFragment_to_previewFragment"
            app:destination="@id/previewFragment" />
    </fragment>

    <fragment
        android:id="@+id/previewFragment"
        android:name="com.aiface.aging.features.home.preview.PreviewFragment"
        android:label="Preview"
        tools:layout="@layout/fragment_preview">
        <argument
            android:name="previewImageUrl"
            android:defaultValue="https://picsum.photos/600/900"
            app:argType="string" />
        <action
            android:id="@+id/actionAiPreviewToImagPicker"
            app:destination="@id/imagePicker" />
    </fragment>

    <fragment
        android:id="@+id/imagePicker"
        android:name="com.aiface.aging.features.imgpicker.ui.FragmentImagePicker"
        tools:layout="@layout/fragment_image_picker_bgremover">
        <argument
            android:name="selectedPosition"
            android:defaultValue="0"
            app:argType="integer" />
        <argument
            android:name="showToolbar"
            android:defaultValue="false"
            app:argType="boolean" />
        <argument
            android:name="albumName"
            android:defaultValue=""
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/editFragment"
        android:name="com.aiface.aging.features.edit.EditFragment"
        android:label="Edit"
        tools:layout="@layout/fragment_edit">
        <argument
            android:name="imageUri"
            app:argType="string" />
        <action
            android:id="@+id/action_editFragment_to_resultFragment"
            app:destination="@id/resultPreviewFragment"
            app:popUpTo="@id/resultPreviewFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <action
        android:id="@+id/action_to_editFragment"
        app:destination="@id/editFragment" />

</navigation>
