<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/adjustLayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
   android:paddingBottom="@dimen/_12sdp"
    >

    <ImageView
        android:id="@+id/btn_cross"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent"
       app:layout_constraintStart_toStartOf="parent"
        android:src="@drawable/ic_cross"
        />


    <ImageView
        android:id="@+id/btn_tick"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_alignParentEnd="true"
        android:src="@drawable/ic_tick_24"
        />


    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.5"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableTop="@drawable/ic_rotate_right_new"
        android:drawableTint="@color/white"
        android:textColor="@color/white"
        android:text="@string/right"
        android:textAllCaps="false"
        android:layout_marginTop="@dimen/_12sdp"
        app:layout_constraintEnd_toStartOf="@id/guide"
        app:layout_constraintTop_toBottomOf="@id/btn_tick"
        android:layout_marginEnd="@dimen/_8sdp"
        android:background="@color/transparent"
        android:fontFamily="@font/inter_medium"
        android:textSize="@dimen/_8ssp"/>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableTop="@drawable/ic_rotate_left_new"
        android:drawableTint="@color/white"
        android:textColor="@color/white"
        android:text="@string/left"
        android:textAllCaps="false"
        app:layout_constraintEnd_toStartOf="@id/btn_right"
        app:layout_constraintTop_toTopOf="@id/btn_right"
        android:layout_marginEnd="@dimen/_8sdp"
        android:background="@color/transparent"
        android:fontFamily="@font/inter_medium"
        android:textSize="@dimen/_8ssp"/>




    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_ver"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableTop="@drawable/ic_flip_vertical_new"
        android:drawableTint="@color/white"
        android:textColor="@color/white"
        android:text="@string/vertical"
        android:textAllCaps="false"
        app:layout_constraintStart_toEndOf="@id/guide"
        app:layout_constraintTop_toTopOf="@id/btn_right"
        android:background="@color/transparent"
        android:fontFamily="@font/inter_medium"
        android:textSize="@dimen/_8ssp"/>


    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btn_hor"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:drawableTop="@drawable/ic_flip_horizontal_new"
        android:text="@string/horizontal"
        android:drawableTint="@color/white"
        android:textColor="@color/white"
        android:textAllCaps="false"
        app:layout_constraintStart_toEndOf="@id/btn_ver"
        app:layout_constraintTop_toTopOf="@id/btn_right"
        android:layout_marginStart="@dimen/_8sdp"
        android:background="@color/transparent"
        android:fontFamily="@font/inter_medium"
        android:textSize="@dimen/_8ssp"/>


</androidx.constraintlayout.widget.ConstraintLayout>