<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingVertical="@dimen/_20sdp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context="com.aiface.aging.features.look.instruction.InstructionFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="@dimen/_20sdp"
        app:layout_constraintBottom_toTopOf="@+id/clAd"
        app:layout_constraintTop_toTopOf="parent"
        >
        <!-- Title -->
        <ImageView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5sdp"
            android:src="@drawable/ic_arrow_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center"/>
        <TextView
            android:id="@+id/tvInstruction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/instruction"
            android:textSize="@dimen/_20ssp"
            android:textStyle="bold"
            android:textColor="@color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:gravity="center"/>

        <!-- Select photos row -->
        <LinearLayout
            android:id="@+id/llSelectPhotos"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvInstruction"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_photos"
                android:textSize="@dimen/_15ssp"
                android:textColor="@color/black"
                android:textStyle="bold"/>

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/camera_1_svg"
                android:layout_marginStart="8dp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/followTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/follow_these_instructions_for_the_best_results"
            android:textSize="@dimen/_11ssp"
            android:fontFamily="@font/inter_medium"
            android:textColor="@color/gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llSelectPhotos" />

        <!-- Requirements Section -->
        <LinearLayout
            android:id="@+id/llRequirements"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/followTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/tick_green"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/requirements"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_15ssp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/please_select_a_high_quality_picture_with_the_perfect_angle_for_better_results_"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/gray"
                android:layout_marginTop="4dp"/>

            <!-- Good examples -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_59sdp"
                    android:layout_weight="1"
                    android:src="@drawable/recomend1"
                    android:scaleType="fitXY"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_59sdp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:src="@drawable/recomend2"
                    android:scaleType="fitXY"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_59sdp"
                    android:layout_weight="1"
                    android:src="@drawable/recomend3"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:scaleType="fitXY"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_59sdp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:src="@drawable/recomend4"
                    android:scaleType="fitXY"
                    />
            </LinearLayout>
        </LinearLayout>

        <!-- Don't Use Section -->
        <LinearLayout
            android:id="@+id/llDontUse"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/llRequirements"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/cross_red"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/don_t_use"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:textSize="@dimen/_15ssp"
                    android:layout_marginStart="8dp"/>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/group_or_full_body_photos_burst_shots_covered_faces_child_photos_nudity_animals_photo"
                android:textSize="@dimen/_11ssp"
                android:fontFamily="@font/inter_medium"
                android:textColor="@color/gray"
                android:layout_marginTop="4dp"/>

            <!-- Bad examples -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_59sdp"
                    android:layout_weight="1"
                    android:src="@drawable/not_rec1"
                    android:scaleType="fitXY"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_59sdp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:src="@drawable/not_rec2"
                    android:scaleType="fitXY"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_59sdp"
                    android:layout_weight="1"
                    android:src="@drawable/not_reco3"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:scaleType="fitXY"
                    />

                <ImageView
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_59sdp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/_5sdp"
                    android:src="@drawable/not_reco4"
                    android:scaleType="fitXY"
                    />
            </LinearLayout>
        </LinearLayout>

        <!-- Button -->
        <!-- Got It Button -->
        <TextView
            android:id="@+id/btnGotIt"
            android:layout_width="0dp"
            app:layout_constraintWidth_percent="0.8"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_gradient"
            android:drawablePadding="@dimen/_5sdp"
            android:gravity="center"
            android:padding="@dimen/_12ssp"
            android:text="@string/got_it"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_13ssp"
            android:layout_marginTop="@dimen/_16sdp"
            android:layout_marginBottom="@dimen/_10sdp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/llDontUse"
            app:layout_constraintVertical_bias="0" />
    </androidx.constraintlayout.widget.ConstraintLayout>



    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/gray01"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <FrameLayout
            android:id="@+id/shimmer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <include
                android:id="@+id/shimmer_container_native"
                layout="@layout/layout_loading_ads_native_small" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/nativeAdView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
