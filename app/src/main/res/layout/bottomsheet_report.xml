<?xml version="1.0" encoding="utf-8"?>
    <androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/report_bottomsheet_rounded"
    android:backgroundTint="@color/white"
        android:paddingBottom="@dimen/_10sdp"
        >

        <View
            android:id="@+id/view"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_3sdp"
            android:layout_marginTop="@dimen/_10sdp"
            android:background="@drawable/bg_rounded_constraintlayout"
            android:backgroundTint="@color/grey3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.002"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <TextView
            android:id="@+id/tv_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:fontFamily="@font/inter_semibold"
            android:text="Feedback/Report"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/_15ssp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/view"/>


        <LinearLayout
            android:id="@+id/ll1"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/tv_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/selector1"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_radio_selected"/>

            <TextView
                android:id="@+id/textView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/i_like_it"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_12ssp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginStart="8dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll2"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/ll1"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/selector2"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_radio_unselected"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/not_what_expect"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_12ssp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginStart="8dp" />

        </LinearLayout>
        <LinearLayout
            android:id="@+id/ll3"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@id/ll2"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center_vertical"
            android:padding="8dp">

            <ImageView
                android:id="@+id/selector3"
                android:layout_width="@dimen/_25sdp"
                android:layout_height="@dimen/_25sdp"
                app:layout_constraintEnd_toEndOf="parent"
                android:src="@drawable/ic_radio_unselected"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inapproriate_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/_12ssp"
                android:fontFamily="@font/inter_regular"
                android:layout_marginStart="8dp" />

        </LinearLayout>

