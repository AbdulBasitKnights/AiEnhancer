<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="itemClickListener"
            type="android.view.View.OnClickListener" />

        <variable
            name="modelStickerPack"
            type="com.aiface.aging.features.filters.model.ModelStickerPack" />


    </data>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/_5sdp">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="@dimen/_5sdp"
            app:cardBackgroundColor="@color/bg_editor"
            android:padding="1dp"
            android:onClick="@{itemClickListener}">

            <ImageView
                android:id="@+id/frame_head_img"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                app:loadDrawableAsResource="@{modelStickerPack.file}" />

        </androidx.cardview.widget.CardView>



        <!--<ImageView
            android:id="@+id/tagImage"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:layout_alignParentEnd="true"
            android:clickable="false"
            android:visibility="gone"
            android:adjustViewBounds="true"
            app:framesDao="@{framesDao}" />-->
    </RelativeLayout>

</layout>