<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:bind="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <variable
            name="isSelected"
            type="boolean" />

        <variable
            name="mediaCountText"
            type="String" />

        <variable
            name="album"
            type="com.aiface.aging.features.imgpicker.model.Album" />

    </data>

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:foreground="?android:attr/selectableItemBackground">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/list_item_container_padding_small">

            <androidx.cardview.widget.CardView
                android:id="@+id/view_image"
                android:layout_width="@dimen/list_item_avatar_size_large"
                android:layout_height="@dimen/list_item_avatar_size_large"
                android:layout_gravity="center_horizontal"
                android:elevation="@dimen/_5sdp"
                app:cardCornerRadius="@dimen/_5sdp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/iv_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    bind:imageUri="@{album.thumbnailUri}" />

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/ted_image_picker_selected_foreground"
                    android:padding="@dimen/default_padding_small"
                    android:src="@drawable/ic_check"
                    android:visibility="@{isSelected}" />

            </androidx.cardview.widget.CardView>

            <TextView
                android:id="@+id/tv_name"
                android:textColor="@color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_3sdp"
                android:ellipsize="end"
                android:maxWidth="100dp"
                android:fontFamily="@font/urbanist_medium"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:text="@{album.name}"
                tools:text="All All AllAllAllAllAllAll" />

            <TextView
                android:id="@+id/tv_count"
                style="@style/TextAppearance.AppCompat.Subhead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/_2sdp"
                android:maxWidth="100dp"
                android:ellipsize="end"
                android:fontFamily="@font/urbanist_medium"
                android:gravity="center_vertical"
                android:text="@{mediaCountText}"
                android:textColor="@color/txt_medium_gray"
                tools:text="3510" />

        </LinearLayout>
    </FrameLayout>
</layout>