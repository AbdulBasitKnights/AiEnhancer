<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="itemClickListener"
            type="android.view.View.OnClickListener" />

        <variable
            name="mediaStoreImage"
            type="com.aiface.aging.features.mywork.MediaStoreImage" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_4sdp"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_2sdp"
        app:cardCornerRadius="@dimen/_15sdp"
        android:foreground="@drawable/bg_mywork"
        app:cardElevation="0dp"
        android:onClick="@{itemClickListener}">

        <ImageView
            android:id="@+id/frame_head_img"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            app:loadImageMyWork="@{mediaStoreImage.path}" />
    </androidx.cardview.widget.CardView>

</layout>