<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:focusable="true"
    android:background="@color/white"
    android:clickable="true"
    android:layout_marginTop="@dimen/_1sdp">

        <ImageView
            android:id="@+id/preview_iv"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:padding="5dp"
            app:layout_constraintHeight_percent="0.9"
            app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/back"
        android:visibility="visible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_arrow_back"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="@dimen/_5sdp"
        android:padding="@dimen/_5sdp"
        app:tint="@color/text_primary" />

        <TextView
            android:id="@+id/share_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:paddingVertical="10dp"
            android:paddingHorizontal="20dp"
            android:text="Share"
            android:layout_marginBottom="@dimen/_10sdp"
            android:textColor="@color/text_primary"
            app:drawableTopCompat="@drawable/ic_share"
            app:drawableTint="@color/text_primary"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@drawable/bg_segment_unselected"
            android:backgroundTint="@color/surfaceDark"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/preview_iv" />
        <!--android:padding="5dp"-->

        <!--<TextView
            android:id="@+id/rate_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:padding="5dp"
            android:text="Rate App"
            android:textColor="@color/white"
            android:textSize="16sp"
            app:drawableTopCompat="@drawable/ic_next"
            app:drawableTint="@color/white"
            app:layout_constraintStart_toEndOf="@id/share_tv"
            app:layout_constraintTop_toBottomOf="@id/lang_tv"
            app:layout_constraintEnd_toEndOf="parent" />-->
</androidx.constraintlayout.widget.ConstraintLayout>