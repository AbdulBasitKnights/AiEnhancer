<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/li_main_face"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="invisible">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">

                <RelativeLayout
                    android:id="@+id/li_parent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/li_11"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <RelativeLayout
                            android:id="@+id/li_seekbar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@android:color/transparent"
                                android:baselineAligned="false"
                                android:gravity="center">

                                <RelativeLayout
                                    android:id="@+id/arc_layout"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"

                                    app:arc_cropCurve="cropConvex"
                                    app:arc_height="@dimen/_37sdp"
                                    app:arc_position="top">

                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_centerHorizontal="true"
                                        android:layout_centerVertical="true">

                                        <com.marcinmoskala.arcseekbar.ArcSeekBar
                                            android:id="@+id/seekbar_text"
                                            android:layout_width="match_parent"
                                            android:layout_height="0dp"
                                            app:progress="100"
                                            app:progressBackgroundColor="@color/home_card_bg"
                                            app:progressBackgroundWidth="@dimen/_8sdp"
                                            app:progressColor="@color/primaryColor"
                                            app:progressWidth="@dimen/_8sdp"
                                            app:roundEdges="false" />
                                        <!--app:progressBackgroundColor="@color/color_seekBar_base"
                                        app:progressColor="@color/tint_1"-->

                                        <SeekBar
                                            android:id="@+id/seek"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginLeft="@dimen/_30sdp"
                                            android:layout_marginRight="@dimen/_30sdp"
                                            android:max="100"
                                            android:paddingTop="@dimen/_10sdp"
                                            android:paddingBottom="@dimen/_10sdp"
                                            android:progress="50" />

                                        <LinearLayout
                                            android:id="@+id/li_subitem"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:layout_marginTop="@dimen/_25sdp"
                                            android:gravity="center"
                                            android:orientation="horizontal"
                                            android:visibility="gone">

                                            <LinearLayout
                                                android:id="@+id/li_draw"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:gravity="center"
                                                android:orientation="vertical"
                                                android:paddingLeft="@dimen/_5sdp"
                                                android:paddingRight="@dimen/_5sdp">

                                                <LinearLayout
                                                    android:layout_width="@dimen/_35sdp"
                                                    android:layout_height="@dimen/_35sdp"
                                                    android:layout_gravity="center"
                                                    android:gravity="center"
                                                    android:orientation="vertical">

                                                    <ImageView
                                                        android:id="@+id/img_draw"
                                                        android:layout_width="@dimen/_34sdp"
                                                        android:layout_height="@dimen/_34sdp"
                                                        android:gravity="center"
                                                        android:padding="@dimen/_5sdp"
                                                        android:src="@drawable/iv_draw_brush" />
                                                </LinearLayout>

                                                <TextView
                                                    android:id="@+id/txt_draw"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="center"
                                                    android:gravity="center"
                                                    android:text="Draw"
                                                    android:textColor="@color/text_secondary"
                                                    android:textSize="@dimen/_8sdp" />
                                            </LinearLayout>

                                            <LinearLayout
                                                android:id="@+id/li_erase"
                                                android:layout_width="wrap_content"
                                                android:layout_height="wrap_content"
                                                android:layout_gravity="center"
                                                android:gravity="center"
                                                android:orientation="vertical"
                                                android:paddingLeft="@dimen/_5sdp"
                                                android:paddingRight="@dimen/_5sdp">

                                                <LinearLayout
                                                    android:layout_width="@dimen/_35sdp"
                                                    android:layout_height="@dimen/_35sdp"
                                                    android:layout_gravity="center"
                                                    android:gravity="center">

                                                    <ImageView
                                                        android:id="@+id/img_eraser"
                                                        android:layout_width="@dimen/_34sdp"
                                                        android:layout_height="@dimen/_34sdp"
                                                        android:gravity="center"
                                                        android:padding="@dimen/_5sdp"
                                                        android:src="@drawable/eraser"
                                                        app:tint="@color/black" />
                                                </LinearLayout>

                                                <TextView
                                                    android:id="@+id/txt_eraser"
                                                    android:layout_width="match_parent"
                                                    android:layout_height="wrap_content"
                                                    android:layout_gravity="center"
                                                    android:gravity="center"
                                                    android:text="Eraser"
                                                    android:textColor="@color/text_secondary"
                                                    android:textSize="@dimen/_8sdp" />
                                            </LinearLayout>
                                        </LinearLayout>
                                    </RelativeLayout>
                                </RelativeLayout>
                            </RelativeLayout>
                        </RelativeLayout>

                        <LinearLayout
                            android:background="@color/home_card_bg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rv_edittext"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:background="@color/home_card_bg"
                                android:clipToPadding="false"
                                android:gravity="center"
                                android:visibility="gone" />
                        </LinearLayout>

                        <include layout="@layout/layout_bottom_done" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
