<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/dialog_bg_white"
    android:paddingTop="@dimen/_5sdp"
    android:paddingBottom="@dimen/_15sdp"
    android:paddingHorizontal="@dimen/_20sdp">

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/_10sdp"
        android:fontFamily="@font/inter_medium"
        android:textColor="@color/text_primary"
        android:text="Warning!"
        android:textSize="@dimen/_13ssp" />

    <TextView
        android:id="@+id/inputEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/titleText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_10sdp"
        android:focusable="true"
        android:fontFamily="@font/inter_medium"
        android:gravity="center"
        android:maxLines="2"
        android:text="Are you sure to delete this image?"
        android:textColor="#A5A5A5"
        android:textSize="@dimen/_11ssp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/inputEditText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/_15sdp"
        android:orientation="horizontal">



        <TextView
            android:id="@+id/buttonNo"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/_5sdp"
            android:background="@drawable/bg_unselected_btn"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:paddingVertical="@dimen/_5sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:text="@string/no"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/_13ssp"
            />

        <TextView
            android:id="@+id/buttonYes"
            android:layout_width="@dimen/_60sdp"
            android:layout_height="match_parent"
            android:paddingVertical="@dimen/_5sdp"
            android:paddingHorizontal="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_5sdp"
            android:background="@drawable/bg_selected_btn"
            android:fontFamily="@font/inter_medium"
            android:gravity="center"
            android:text="@string/save_dialog_yes"
            android:textAllCaps="false"
            android:textColor="@color/lineColor"
            android:textSize="@dimen/_13ssp"
         />

<!--        <androidx.appcompat.widget.AppCompatButton-->
<!--            android:id="@+id/buttonYes"-->
<!--            android:layout_width="wrap_content"-->
<!--            android:layout_height="@dimen/_27sdp"-->
<!--            android:layout_marginStart="@dimen/_10sdp"-->
<!--            android:background="@drawable/rounded_filled_dark_blue"-->
<!--            android:text="Yes"-->
<!--            android:fontFamily="@font/poppins_medium"-->
<!--            android:textAllCaps="false"-->
<!--            android:textColor="@color/white"-->
<!--            android:textSize="@dimen/_11ssp" />-->
    </LinearLayout>

</RelativeLayout>