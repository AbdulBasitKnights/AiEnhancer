<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_editor">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_toolbar"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                app:layout_constraintTop_toTopOf="parent"
                android:gravity="center_vertical">

                <ImageView
                    android:id="@+id/back"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:padding="@dimen/_5sdp"
                    android:src="@drawable/icon_back"/>

                <androidx.constraintlayout.widget.Guideline
                    android:id="@+id/guide1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintGuide_percent=".50"/>

                <ImageView
                    android:id="@+id/undoButton"
                    android:layout_width="@dimen/_27sdp"
                    android:layout_height="@dimen/_27sdp"
                    android:gravity="center"
                    app:layout_constraintEnd_toStartOf="@id/guide1"
                    android:layout_marginEnd="@dimen/_10sdp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:background="@drawable/icon_undo" />

                <ImageView
                    android:id="@+id/redoButton"
                    android:layout_width="@dimen/_27sdp"
                    android:layout_height="@dimen/_27sdp"
                    android:gravity="center"
                    app:layout_constraintStart_toEndOf="@id/guide1"
                    app:layout_constraintTop_toTopOf="@id/undoButton"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:background="@drawable/icon_redo" />

                <TextView
                    android:id="@+id/btn_save"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_10sdp"
                    android:background="@drawable/rounded_filled_dark_blue"
                    android:backgroundTint="@color/colorHighlightBlueDark"
                    android:gravity="center"
                    android:paddingLeft="@dimen/_15sdp"
                    android:paddingTop="@dimen/_5sdp"
                    android:paddingRight="@dimen/_15sdp"
                    android:paddingBottom="@dimen/_5sdp"
                    android:text="@string/save"
                    android:fontFamily="@font/inter_medium"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11ssp"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/cl_toolbar"
                app:layout_constraintBottom_toBottomOf="parent">

                <RelativeLayout
                    android:id="@+id/mainLayout"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg"
                    android:paddingBottom="50dp"
                    android:gravity="center">

                </RelativeLayout>

                <ImageView
                    android:visibility="gone"
                    android:id="@+id/colorButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentLeft="true"
                    android:layout_alignParentTop="true"
                    android:background="@drawable/white_drawable"
                    android:layout_margin="10dp" />

                <RelativeLayout
                    android:id="@+id/subBottomBar"
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="#00000000"
                    android:layout_above="@+id/cl_tools"
                    android:gravity="center_vertical">

                    <RelativeLayout
                        android:id="@+id/magicWand_layout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="#80000000"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <ImageButton
                            android:visibility="gone"
                            android:id="@+id/magic_remove_button"
                            android:layout_width="36dp"
                            android:layout_height="45dp"
                            android:layout_alignParentLeft="true"
                            android:scaleType="fitXY"
                            android:layout_marginLeft="10dp"
                            android:background="@drawable/magic_remove_button" />

                        <ImageButton
                            android:visibility="gone"
                            android:id="@+id/magic_restore_button"
                            android:layout_width="36dp"
                            android:layout_height="45dp"
                            android:layout_marginLeft="10dp"
                            android:scaleType="fitStart"
                            android:layout_toRightOf="@+id/magic_remove_button"
                            android:background="@drawable/magic_restore_button" />

                        <SeekBar
                            android:id="@+id/magic_seekbar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingBottom="10dp"
                            android:layout_marginHorizontal="@dimen/_5sdp"
                            android:max="30"
                            android:progressDrawable="@drawable/progress"
                            android:thumb="@drawable/thumb" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/eraser_layout"
                        android:layout_width="match_parent"
                        android:layout_height="70dp"
                        android:background="@drawable/erase_background"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <ImageButton
                            android:id="@+id/erase_sub_button"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_alignParentLeft="true"
                            android:scaleType="fitXY"
                            android:layout_marginLeft="10dp"
                            android:background="@drawable/eraser_sub_button" />

                        <ImageButton
                            android:id="@+id/unerase_sub_button"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_marginLeft="10dp"
                            android:scaleType="fitStart"
                            android:layout_toRightOf="@+id/erase_sub_button"
                            android:background="@drawable/uneraser_sub_button" />

                        <ImageButton
                            android:id="@+id/brush_size_1_button"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_marginRight="7dp"
                            android:layout_toLeftOf="@+id/brush_size_2_button"
                            android:background="@drawable/brush_size1_button" />

                        <ImageButton
                            android:id="@+id/brush_size_2_button"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_toLeftOf="@+id/brush_size_3_button"
                            android:layout_marginRight="7dp"
                            android:background="@drawable/brush_size2_button" />

                        <ImageButton
                            android:id="@+id/brush_size_3_button"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_marginRight="7dp"
                            android:layout_toLeftOf="@+id/brush_size_4_button"
                            android:background="@drawable/brush_size3_button" />

                        <ImageButton
                            android:id="@+id/brush_size_4_button"
                            android:layout_width="45dp"
                            android:layout_height="45dp"
                            android:layout_alignParentRight="true"
                            android:layout_marginRight="10dp"
                            android:background="@drawable/brush_size4_button" />
                    </RelativeLayout>
                </RelativeLayout>

                <RelativeLayout
                    android:visibility="gone"
                    android:id="@+id/bottomBar"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_alignParentBottom="true"
                    android:background="@color/bg_editor"
                    android:paddingTop="3dp">

                    <Button
                        android:id="@+id/magicButtonold"
                        android:layout_width="70dp"
                        android:layout_height="45dp"
                        android:layout_alignParentLeft="true"
                        android:layout_marginLeft="2dp"
                        android:textSize="12dp"
                        android:text="Magic" />

                    <Button
                        android:id="@+id/eraseButtonold"
                        android:layout_width="70dp"
                        android:layout_height="45dp"
                        android:layout_marginLeft="1dp"
                        android:layout_toRightOf="@+id/magicButtonold"
                        android:textSize="12dp"
                        android:text="Eraser" />

                    <Button
                        android:id="@+id/mirrorButton"
                        android:layout_width="70dp"
                        android:layout_height="45dp"
                        android:layout_marginRight="1dp"
                        android:layout_toLeftOf="@+id/positionButtonold"
                        android:textSize="12dp"
                        android:text="Mirror" />

                    <Button
                        android:id="@+id/positionButtonold"
                        android:layout_width="80dp"
                        android:layout_height="45dp"
                        android:layout_alignParentRight="true"
                        android:textSize="12dp"
                        android:text="Position" />
                </RelativeLayout>

                <RelativeLayout
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_alignParentBottom="true"
                    android:layout_gravity="center"
                    android:background="#00000000"
                    android:gravity="center">

                    <Button
                        android:id="@+id/nextButton"
                        android:layout_width="60dp"
                        android:layout_height="50dp"
                        android:layout_centerHorizontal="true"
                        android:text="Save"
                        android:scaleType="fitXY" />
                </RelativeLayout>

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/cl_tools"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/bg_editor"
                    android:paddingTop="@dimen/_8sdp"
                    android:paddingBottom="@dimen/_8sdp"
                    android:layout_alignParentBottom="true">



                    <ImageView
                        android:id="@+id/positionButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_zoom_out_24dp"
                        android:layout_marginStart="@dimen/_20sdp"
                        android:padding="@dimen/_5sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white" />
                    <TextView
                        android:id="@+id/tv_zoom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/zoom"
                        android:textColor="@color/white"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintStart_toStartOf="@id/positionButton"
                        app:layout_constraintEnd_toEndOf="@id/positionButton"
                        app:layout_constraintTop_toBottomOf="@id/positionButton"
                        />

                    <ImageView
                        android:id="@+id/magicButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_magic_eraser"
                        android:padding="@dimen/_5sdp"
                        app:layout_constraintStart_toEndOf="@id/positionButton"
                        app:layout_constraintEnd_toStartOf="@id/iv_magic_brush"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white" />
                    <TextView
                        android:id="@+id/tv_magic_eraser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/magic_eraser"
                        android:textColor="@color/white"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintStart_toStartOf="@id/magicButton"
                        app:layout_constraintEnd_toEndOf="@id/magicButton"
                        app:layout_constraintTop_toBottomOf="@id/magicButton"
                        />


                    <ImageView
                        android:id="@+id/iv_magic_brush"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_magic_brush"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:padding="@dimen/_5sdp"
                        app:layout_constraintStart_toEndOf="@id/magicButton"
                        app:layout_constraintEnd_toStartOf="@id/eraseButton"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white" />
                    <TextView
                        android:id="@+id/tv_magic_brush"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/magic_brush"
                        android:textColor="@color/white"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintStart_toStartOf="@id/iv_magic_brush"
                        app:layout_constraintEnd_toEndOf="@id/iv_magic_brush"
                        app:layout_constraintTop_toBottomOf="@id/iv_magic_brush"
                        />


                    <ImageView
                        android:id="@+id/eraseButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/ic_eraser"
                        android:layout_marginEnd="@dimen/_20sdp"
                        android:padding="@dimen/_5sdp"
                       app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:tint="@color/white" />
                    <TextView
                        android:id="@+id/tv_eraser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eraser"
                        android:textColor="@color/white"
                        android:fontFamily="@font/inter_regular"
                        android:textSize="@dimen/_10ssp"
                        app:layout_constraintStart_toStartOf="@id/eraseButton"
                        app:layout_constraintEnd_toEndOf="@id/eraseButton"
                        app:layout_constraintTop_toBottomOf="@id/eraseButton"
                        />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </RelativeLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>