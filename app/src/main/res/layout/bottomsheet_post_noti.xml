<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/_10sdp"
    android:paddingHorizontal="@dimen/_10sdp"
    android:background="#66000000"
    xmlns:app="http://schemas.android.com/apk/res-auto">


    <ImageView
        android:id="@+id/icon"
        android:layout_width="@dimen/_25sdp"
        android:layout_height="@dimen/_25sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_10sdp"
        android:src="@drawable/ic_noti_"/>
    <TextView
        android:id="@+id/tv_default"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/icon"
        android:layout_marginTop="@dimen/_10sdp"
        android:layout_marginHorizontal="@dimen/_40sdp"
        android:text="@string/enable_app_noti"
        android:textColor="@color/white"
        android:fontFamily="@font/inter_medium"
        android:textSize="@dimen/_13ssp"/>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/unselected_color"
        app:layout_constraintTop_toBottomOf="@id/tv_default"
        android:layout_marginTop="@dimen/_10sdp">





        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent=".50"
            />

        <View
            android:id="@+id/view3"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:layout_marginStart="@dimen/_3sdp"
            android:background="@drawable/bg_rounded_constraintlayout_gradient"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toEndOf="@id/guide"
            app:layout_constraintEnd_toEndOf="parent"
           />

        <TextView
            android:id="@+id/btn_allow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/allow"
            android:layout_marginStart="@dimen/_3sdp"
            android:textColor="@color/white"
            android:fontFamily="@font/inter_bold"
            android:textSize="@dimen/_12ssp"
            app:layout_constraintTop_toTopOf="@id/view3"
            app:layout_constraintBottom_toBottomOf="@id/view3"
            app:layout_constraintStart_toStartOf="@id/view3"
            app:layout_constraintEnd_toEndOf="@id/view3"/>

        <TextView
            android:id="@+id/btn_dont_allow"
            android:layout_width="0dp"
            android:layout_height="@dimen/_40sdp"
            android:background="@drawable/bg_rounded_constraintlayout_gradient"
            android:backgroundTint="@color/gray"
            android:layout_marginEnd="@dimen/_3sdp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/guide"
            android:text="@string/don_t_allow"
            android:textColor="@color/white"
            android:fontFamily="@font/inter_medium"
            android:textSize="@dimen/_12ssp"
            android:gravity="center"
            />


    </androidx.constraintlayout.widget.ConstraintLayout>



</androidx.constraintlayout.widget.ConstraintLayout>