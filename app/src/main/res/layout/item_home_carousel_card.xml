<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/_90sdp"
    android:layout_height="@dimen/_110sdp"
    android:layout_marginEnd="@dimen/_10sdp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCarouselThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_home_carousel_card"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/RoundedImage16"
        tools:src="@drawable/img_selfie_enhancer" />

    <TextView
        android:id="@+id/tvCarouselTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_home_promo_scrim"
        android:ellipsize="end"
        android:fontFamily="@font/inter_semibold"
        android:maxLines="2"
        android:padding="@dimen/_8sdp"
        android:textColor="@color/white"
        android:textSize="@dimen/_10ssp"
        tools:text="Twin Shot" />
</FrameLayout>
