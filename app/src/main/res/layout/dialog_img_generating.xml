<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:ads="http://schemas.android.com/apk/res-auto"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"

   >


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_marginHorizontal="@dimen/_10sdp"
        android:background="@drawable/bg_dialog_exit"
        android:paddingBottom="@dimen/_30sdp"
        android:paddingTop="@dimen/_5sdp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        tools:ignore="MissingConstraints">




    <ImageView
        android:id="@+id/loading_gif"
        android:layout_width="80dp"
        android:layout_height="80dp"
        ads:layout_constraintTop_toTopOf="parent"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintEnd_toEndOf="parent"
        android:src="@drawable/video_processing"
        android:adjustViewBounds="true"
        android:layout_marginBottom="@dimen/_8sdp"/>

    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        ads:layout_constraintTop_toBottomOf="@id/loading_gif"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintEnd_toEndOf="parent"
        android:fontFamily="@font/inter_bold"
        android:text="@string/your_image_is_generating"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/_16ssp" />

    <TextView
        android:id="@+id/inputEditText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/titleText"
        android:layout_centerHorizontal="true"
        ads:layout_constraintTop_toBottomOf="@id/titleText"
        ads:layout_constraintStart_toStartOf="parent"
        ads:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_10sdp"
        android:focusable="true"
        android:fontFamily="@font/inter_regular"
        android:gravity="center_horizontal"
        android:maxLines="2"
        android:text="@string/this_may_take_few_moments"
        android:textColor="#A5A5A5"
        android:textSize="@dimen/_12ssp" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>